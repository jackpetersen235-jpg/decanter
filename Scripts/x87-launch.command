#!/bin/bash
#
# Launch a Decanter game through x87sidecar — for OLD 32-bit games only.
#
# WHY: Rosetta 2 emulates x87 floating-point maths in software, and it is roughly 100x slower than
# it should be. Games from before ~2010 do their maths on the x87 FPU, so they crawl. Modern
# 64-bit games use SSE instead and are unaffected — this will do NOTHING for them.
#
# WHAT IT DOES: takes the exact command Decanter's own launcher would run, and runs it through
# x87sidecar, which replaces Rosetta's slow x87 handlers with a faster JIT.
#
# ⚠️ THIS NEEDS YOUR ADMIN PASSWORD. x87sidecar patches Rosetta inside the running game process,
# and macOS requires root for that. It is a third-party open-source tool (MIT licensed) and is NOT
# part of Decanter. Read its source if you would rather not take that on trust:
#   https://github.com/athei/x87sidecar
set -uo pipefail
cd "$(dirname "$0")" || exit 1

say()  { printf '%s\n' "$1"; }
die()  { printf '\n❌ %s\n' "$1"; read -r -p "Press return to close." _; exit 1; }

SIDECAR=""
for c in "./x87sidecar" "$HOME/Downloads/x87sidecar" "/usr/local/bin/x87sidecar"; do
    [ -x "$c" ] && { SIDECAR="$c"; break; }
done

if [ -z "$SIDECAR" ]; then
    say "x87sidecar was not found."
    say ""
    say "Get it first:"
    say "  1. Open  https://github.com/athei/x87sidecar/releases"
    say "  2. Download the .tar.xz for Apple Silicon and double-click to extract."
    say "  3. Put the 'x87sidecar' file NEXT TO THIS SCRIPT, or in your Downloads folder."
    say "  4. Clear the download flag so macOS will run it:"
    say "        xattr -d com.apple.quarantine ~/Downloads/x87sidecar"
    say "  5. Run this script again."
    die "Nothing was changed."
fi
say "Found x87sidecar: $SIDECAR"

# Reuse Decanter's generated launcher as the source of truth for HOW to start the game, rather than
# reconstructing the wine invocation here. The launcher already resolves the engine, the prefix,
# every DXMT/msync variable and whether the game goes through Steam.
say ""
say "Which game? Launchers found in ~/Applications:"
# NOT `mapfile` — macOS ships bash 3.2, where that builtin does not exist. The script would have
# died here on the target machine while working fine anywhere with a modern bash.
APPS=()
while IFS= read -r line; do
    [ -n "$line" ] && APPS+=("$line")
done < <(grep -rl 'GENERATED BY DECANTER' "$HOME/Applications"/*.app/Contents/MacOS/launch 2>/dev/null)
[ "${#APPS[@]}" -eq 0 ] && die "No Decanter launchers found. Open Decanter and press Play once first."

i=1
for a in "${APPS[@]}"; do
    name=$(basename "$(dirname "$(dirname "$(dirname "$a")")")" .app)
    printf '  %d) %s\n' "$i" "$name"; i=$((i+1))
done
printf '\nNumber: '; read -r PICK
SCRIPT="${APPS[$((PICK-1))]:-}"
[ -f "$SCRIPT" ] || die "That was not one of the options."

# The launcher's last line is the exec that starts the game. Take it verbatim and wrap it.
EXECLINE=$(grep -E '^exec "\$WINE"' "$SCRIPT" | tail -1)
[ -n "$EXECLINE" ] || die "Could not read the launch command out of that launcher."

say ""
say "Decanter would run:"
say "  ${EXECLINE#exec }"
say ""
say "Running it through x87sidecar instead. macOS will now ask for your password."
say ""

# Source the launcher's environment without letting it start the game: everything above the exec.
TMP=$(mktemp)
sed '/^exec "\$WINE"/,$d' "$SCRIPT" > "$TMP"
# shellcheck disable=SC1090
source "$TMP" 2>/dev/null
rm -f "$TMP"

CMD=${EXECLINE#exec }
eval "sudo \"$SIDECAR\" $CMD"
STATUS=$?
say ""
[ $STATUS -eq 0 ] && say "✅ Game exited normally." || say "⚠️  Exited with status $STATUS."
read -r -p "Press return to close." _
